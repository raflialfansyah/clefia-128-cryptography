# Salin menjadi .env untuk pengembangan lokal. Jangan pernah commit .env ke Git.
# Peringatan akademis: gunakan nama pengguna dan kata sandi simulasi saja, jangan gunakan kredensial asli.
# Hasilkan kunci acak secara lokal menggunakan Python:
#   python -c "import secrets; print('CLEFIA_ENC_KEY_HEX=' + secrets.token_hex(16))"
#   python -c "import secrets; print('SESSION_SECRET_KEY=' + secrets.token_urlsafe(48))"

DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DBNAME
CLEFIA_ENC_KEY_HEX=<32_HEX_CHARS>
CLEFIA_KEY_ID=demo-v2
SESSION_SECRET_KEY=<LONG_RANDOM_SECRET>
APP_ENV=development
DEMO_MAX_USERS=100
